{
	"name": "billion-context-pi",
	"version": "0.1.83-lean.7",
	"private": true,
	"description": "Long-term fork of billion-context-pi 0.1.83 for Pi: cheap dedicated summary model, lean tool surface, request-rewrite fixes.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./contract": {
			"types": "./dist/contract.d.ts",
			"import": "./dist/contract.js"
		},
		"./contract/schema": "./schema/bcp-block-v1.json"
	},
	"pi": {
		"extensions": [
			"./lean/index.ts"
		]
	},
	"files": [
		"dist",
		"schema",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"homepage": "https://github.com/kunkun9527/billion-context-pi-lean",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kunkun9527/billion-context-pi-lean.git"
	},
	"bugs": {
		"url": "https://github.com/kunkun9527/billion-context-pi-lean/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"test": "node --import tsx --import ./tests/support/isolate-env.ts --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:lean": "tsc -p lean/tsconfig.json",
		"test:lean": "node --import tsx --import ./tests/support/isolate-env.ts --test lean/tests/*.test.mjs",
		"check": "npm run typecheck && npm test && npm run build && npm run typecheck:lean && npm run test:lean",
		"build": "tsup && tsc --emitDeclarationOnly",
		"e2e": "node scripts/e2e/run-e2e.mjs"
	},
	"keywords": [
		"pi",
		"acp",
		"context",
		"compression",
		"context-management",
		"llm",
		"pi-package"
	],
	"author": "ranxianglei",
	"license": "MIT",
	"type": "module",
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.83.0",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@earendil-works/pi-tui": "0.83.0",
		"@types/node": "^26.1.2",
		"acp-kernel": "0.0.98",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
